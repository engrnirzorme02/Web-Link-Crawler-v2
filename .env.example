# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# SECURITY NOTICE:
# Never commit the actual .env file or any production secrets to source control.
# Copy this file to .env and provide your actual API keys and secrets locally.
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI (Chat, Smart Crawl, URL Filter, Semantic Tagging).
# In Google AI Studio, this is managed via the Secrets Panel.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this applet is hosted (e.g., https://your-domain.run.app).
APP_URL=http://localhost:3000

# BLUEPRINT_ACCESS_PIN: Optional PIN protection for architecture blueprint downloads.
# Defaults to standard internal PIN if not provided.
BLUEPRINT_ACCESS_PIN=10076
VITE_BLUEPRINT_ACCESS_PIN=10076


# NODE_ENV: Application environment ('development' or 'production')
NODE_ENV=development
