# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# NOTICE: PASSIVE PROTECTION MODE ACTIVE
# To prevent Google Cloud policy violations & spam flags, all automated background
# API calls to Google Cloud and Gemini are cancelled & deactivated.
# No active cloud credentials or service accounts are used in background mode.
# ==============================================================================

# GEMINI_API_KEY: Deactivated in Passive Safe Mode.
# GEMINI_API_KEY=deactivated_in_passive_mode

# APP_URL: The URL where this applet is hosted (e.g., https://your-domain.run.app).
APP_URL=http://localhost:3000

# BLUEPRINT_ACCESS_PIN: Optional PIN protection for architecture blueprint downloads.
BLUEPRINT_ACCESS_PIN=10076
VITE_BLUEPRINT_ACCESS_PIN=10076

# NODE_ENV: Application environment ('development' or 'production')
NODE_ENV=development


# Optional remote API base URL for bundled/mobile frontends.
# Leave empty for same-origin web deployments. This value is public in Vite builds.
VITE_API_BASE_URL=

# Exact comma-separated frontend origins allowed by the API server.
# Example Capacitor Android: https://localhost
# Example custom Capacitor scheme: capacitor://localhost
# Add your real hosted frontend origin as needed; do not use *.
CORS_ALLOWED_ORIGINS=
