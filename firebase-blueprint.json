{
  "entities": {
    "users": {
      "title": "User",
      "description": "Registered user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID" },
        "email": { "type": "string", "description": "User email address" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "sessions": {
      "title": "Session",
      "description": "User crawler or extraction session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "type": { "type": "string", "description": "Session type" },
        "title": { "type": "string", "description": "Session title" },
        "results": { "type": "array", "description": "Crawl or extraction results" },
        "logs": { "type": "array", "description": "Execution logs" },
        "tags": { "type": "array", "description": "Tags associated with the session" },
        "isPinned": { "type": "boolean", "description": "Pinned status" },
        "isArchived": { "type": "boolean", "description": "Archived status" },
        "url": { "type": "string", "description": "Target URL" },
        "instruction": { "type": "string", "description": "Extraction or crawl instruction" },
        "aiSummary": { "type": "string", "description": "Summary generated by AI" },
        "notes": { "type": "string", "description": "Optional user rich-text notes for the session" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "title"]
    },
    "blueprint_access_logs": {
      "title": "BlueprintAccessLog",
      "description": "Access logs for blueprint downloads",
      "type": "object",
      "properties": {
        "blueprint": { "type": "string" },
        "version": { "type": "string" },
        "accessedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["blueprint", "version"]
    },
    "blueprint_history": {
      "title": "BlueprintHistory",
      "description": "History of system blueprint versions",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "uiBlueprint": { "type": "string" },
        "devBlueprint": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["version"]
    },
    "crawl_schedules": {
      "title": "CrawlSchedule",
      "description": "Scheduled and recurring crawl jobs for automated website crawling",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "name": { "type": "string", "description": "Friendly name for the schedule" },
        "url": { "type": "string", "description": "Target website URL" },
        "mode": { "type": "string", "description": "Crawl mode (single, subdir, domain)" },
        "frequency": { "type": "string", "description": "Frequency: once, hourly, daily, weekly, monthly" },
        "scheduledTime": { "type": "string", "description": "Specific date/time or cron representation" },
        "nextRunAt": { "type": "string", "format": "date-time" },
        "lastRunAt": { "type": "string", "format": "date-time" },
        "lastStatus": { "type": "string", "description": "Status of last crawl execution: success, failed, running, idle" },
        "lastResultCount": { "type": "number", "description": "Number of links found on last run" },
        "maxPages": { "type": "number" },
        "maxDepth": { "type": "number" },
        "enabled": { "type": "boolean" },
        "notifications": { "type": "boolean" },
        "filters": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "url", "frequency", "enabled"]
    },
    "crawl_logs": {
      "title": "CrawlLog",
      "description": "Execution audit log for crawl tasks and scheduled monitor jobs",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "scheduleId": { "type": "string", "description": "Associated schedule ID if triggered by schedule" },
        "scheduleName": { "type": "string" },
        "url": { "type": "string", "description": "Target URL" },
        "mode": { "type": "string" },
        "status": { "type": "string", "description": "Status: running, completed, failed, stopped" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationSeconds": { "type": "number" },
        "pagesCrawled": { "type": "number" },
        "linksFound": { "type": "number" },
        "errorsCount": { "type": "number" },
        "errorDetails": { "type": "array" },
        "resultsSnippet": { "type": "array" },
        "triggeredBy": { "type": "string", "description": "Trigger source: schedule or manual" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "url", "status", "startedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User profiles restricted to owner"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/sessions" },
      "description": "Crawler sessions private to user"
    },
    "/crawl_schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/crawl_schedules" },
      "description": "Automated crawl jobs private to user"
    },
    "/crawl_logs/{logId}": {
      "schema": { "$ref": "#/entities/crawl_logs" },
      "description": "Execution run history private to user"
    },
    "/blueprint_access_logs/{logId}": {
      "schema": { "$ref": "#/entities/blueprint_access_logs" },
      "description": "Audit log for blueprint downloads"
    },
    "/blueprint_history/{historyId}": {
      "schema": { "$ref": "#/entities/blueprint_history" },
      "description": "Versioned architecture blueprint specs"
    }
  }
}
