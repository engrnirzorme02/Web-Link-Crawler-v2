{
  "entities": {
    "users": {
      "title": "User",
      "description": "Registered user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID" },
        "email": { "type": "string", "description": "User email address" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "sessions": {
      "title": "Session",
      "description": "User crawler or extraction session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "type": { "type": "string", "description": "Session type" },
        "title": { "type": "string", "description": "Session title" },
        "results": { "type": "array", "description": "Crawl or extraction results" },
        "logs": { "type": "array", "description": "Execution logs" },
        "tags": { "type": "array", "description": "Tags associated with the session" },
        "isPinned": { "type": "boolean", "description": "Pinned status" },
        "isArchived": { "type": "boolean", "description": "Archived status" },
        "url": { "type": "string", "description": "Target URL" },
        "instruction": { "type": "string", "description": "Extraction or crawl instruction" },
        "aiSummary": { "type": "string", "description": "Summary generated by AI" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "title"]
    },
    "blueprint_access_logs": {
      "title": "BlueprintAccessLog",
      "description": "Access logs for blueprint downloads",
      "type": "object",
      "properties": {
        "blueprint": { "type": "string" },
        "version": { "type": "string" },
        "accessedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["blueprint", "version"]
    },
    "blueprint_history": {
      "title": "BlueprintHistory",
      "description": "History of system blueprint versions",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "uiBlueprint": { "type": "string" },
        "devBlueprint": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["version"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User profiles restricted to owner"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/sessions" },
      "description": "Crawler sessions private to user"
    },
    "/blueprint_access_logs/{logId}": {
      "schema": { "$ref": "#/entities/blueprint_access_logs" },
      "description": "Audit log for blueprint downloads"
    },
    "/blueprint_history/{historyId}": {
      "schema": { "$ref": "#/entities/blueprint_history" },
      "description": "Versioned architecture blueprint specs"
    }
  }
}
